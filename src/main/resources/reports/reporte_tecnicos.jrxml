<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
    xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
    http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="reporte_tecnicos"
    pageWidth="595"
    pageHeight="842"
    columnWidth="535"
    leftMargin="30"
    rightMargin="30"
    topMargin="25"
    bottomMargin="25">

    <parameter name="TITULO" class="java.lang.String"/>

    <field name="idtecnico" class="java.lang.Integer"/>
    <field name="nombre" class="java.lang.String"/>
    <field name="especialidad" class="java.lang.String"/>
    <field name="telefono" class="java.lang.Integer"/>

    <!-- Título del reporte -->
    <title>
        <band height="65">
            <textField>
                <reportElement x="0" y="5" width="535" height="35" forecolor="#263238"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="18" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{TITULO}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="42" width="535" height="18" forecolor="#607D8B"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isItalic="true"/>
                </textElement>
                <text><![CDATA[LISTADO DE TÉCNICOS REGISTRADOS]]></text>
            </staticText>
        </band>
    </title>

    <!-- Encabezados -->
    <columnHeader>
        <band height="28">
            <staticText>
                <reportElement x="0" y="0" width="50" height="28" mode="Opaque" backcolor="#198754"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[ID]]></text>
            </staticText>

            <staticText>
                <reportElement x="50" y="0" width="180" height="28" mode="Opaque" backcolor="#198754"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[NOMBRE]]></text>
            </staticText>

            <staticText>
                <reportElement x="230" y="0" width="185" height="28" mode="Opaque" backcolor="#198754"/>
                <textElement textAlignment="Center" verticalAlignment="Middle" >
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[ESPECIALIDAD]]></text>
            </staticText>

            <staticText>
                <reportElement x="415" y="0" width="120" height="28" mode="Opaque" backcolor="#198754"/>
                <textElement textAlignment="Center" verticalAlignment="Middle" >
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[TELÉFONO]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- Detalle -->
    <detail>
        <band height="25">
            <rectangle>
                <reportElement x="0" y="0" width="535" height="25" mode="Opaque" backcolor="#F1F5F7">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT}.intValue() % 2 == 0]]></printWhenExpression>
                </reportElement>
            </rectangle>

            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="50" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{idtecnico}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="50" y="0" width="180" height="25"/>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{nombre}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="230" y="0" width="185" height="25"/>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{especialidad}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="415" y="0" width="120" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{telefono}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="0" y="24" width="535" height="1" />
            </line>
        </band>
    </detail>

    <!-- Pie de página -->
    <pageFooter>
        <band height="25">
            <staticText>
                <reportElement x="0" y="5" width="350" height="15" />
                <textElement verticalAlignment="Middle">
                    <font size="8" isItalic="true"/>
                </textElement>
                <text><![CDATA[Reporte de técnicos]]></text>
            </staticText>

            <textField>
                <reportElement x="435" y="5" width="100" height="15" />
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

</jasperReport>